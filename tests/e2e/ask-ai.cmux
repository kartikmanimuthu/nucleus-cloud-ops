#!/usr/bin/env cmux
# E2E test for Ask AI inventory feature
# Tests: navigation → dialog open → question → response with citations → multi-turn

test "Ask AI E2E Flow" {
  # Navigate to inventory page
  navigate "http://localhost:3000/inventory"
  wait_for_navigation
  
  # Wait for page to load
  wait 2000
  
  # Click "Ask AI" button (Sparkles icon button)
  click_element "button:has-text('Sparkles')"
  wait 1000
  
  # Verify dialog opened
  assert_visible "text=Ask AI about your inventory"
  
  # Type question
  fill_input "input[placeholder*='Ask a question']" "How many EC2 instances are in ap-south-1?"
  wait 500
  
  # Submit question
  click_element "button:has-text('Send')"
  wait 3000
  
  # Verify response appears
  assert_visible "text=EC2"
  assert_visible "text=ap-south-1"
  
  # Verify sources/citations are shown
  assert_visible "text=Sources"
  
  # Test multi-turn: click follow-up suggestion
  click_element "button:has-text('Tell me more about the first')"
  wait 3000
  
  # Verify follow-up response appears
  assert_visible "text=instance"
  
  # Verify conversation maintained (both messages visible)
  assert_visible "text=How many EC2 instances"
  
  log "✅ Ask AI E2E test passed"
}

test "Ask AI with Filters" {
  navigate "http://localhost:3000/inventory"
  wait_for_navigation
  wait 2000
  
  # Set filter to ap-south-1 region
  click_element "select[name='region']"
  click_element "option:has-text('ap-south-1')"
  wait 500
  
  # Open Ask AI
  click_element "button:has-text('Sparkles')"
  wait 1000
  
  # Verify filter badge shown in dialog
  assert_visible "text=ap-south-1"
  
  # Ask question
  fill_input "input[placeholder*='Ask a question']" "List all resources"
  click_element "button:has-text('Send')"
  wait 3000
  
  # Verify response respects filter
  assert_visible "text=ap-south-1"
  
  log "✅ Ask AI with filters test passed"
}
