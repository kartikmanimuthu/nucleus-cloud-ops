{
  "name": "workers",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/workers/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/apps/workers/dist"],
      "options": {
        "command": "bun run build",
        "cwd": "apps/workers"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "bun run dev",
        "cwd": "apps/workers"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/coverage"],
      "options": {
        "command": "bun run test",
        "cwd": "apps/workers"
      }
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/coverage"],
      "options": {
        "command": "bun run test:coverage",
        "cwd": "apps/workers"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run test:integration",
        "cwd": "apps/workers"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run typecheck",
        "cwd": "apps/workers"
      }
    }
  }
}