{
  "name": "web-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web-ui",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/apps/web-ui/.next"],
      "options": {
        "command": "node scripts/assert-next-patch.mjs && NODE_ENV=production next build",
        "cwd": "apps/web-ui"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "bun run dev",
        "cwd": "apps/web-ui"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/coverage"],
      "options": {
        "command": "bun run test",
        "cwd": "apps/web-ui"
      }
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/coverage"],
      "options": {
        "command": "bun run test:coverage",
        "cwd": "apps/web-ui"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run test:integration",
        "cwd": "apps/web-ui"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run lint",
        "cwd": "apps/web-ui"
      }
    },
    "rbac-sync": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/libs/rbac/generated"],
      "options": {
        "command": "bun run rbac:sync",
        "cwd": "apps/web-ui"
      }
    },
    "rbac-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run rbac:check",
        "cwd": "apps/web-ui"
      }
    }
  }
}