{
  "name": "nucleus-cloud-ops-ui",
  "version": "0.1.0",
  "private": true,
  "patchedDependencies": {
    "@langchain/core@1.2.1": "patches/@langchain%2Fcore@1.2.1.patch",
    "langchain@1.5.2": "patches/langchain@1.5.2.patch",
    "next@15.5.15": "patches/next@15.5.15.patch"
  },
  "scripts": {
    "predev": "cd ../.. && prisma migrate deploy --schema=./libs/prisma/schema.prisma && prisma db execute --file ./libs/prisma/ensure-vector-indexes.sql --schema=./libs/prisma/schema.prisma",
    "dev": "next dev -p 3001",
    "prestart": "cd ../.. && prisma migrate deploy --schema=./libs/prisma/schema.prisma && prisma db execute --file ./libs/prisma/ensure-vector-indexes.sql --schema=./libs/prisma/schema.prisma",
    "start": "next start -p 3001",
    "prebuild": "node scripts/assert-next-patch.mjs",
    "build": "next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "next lint",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose down",
    "db:generate": "cd ../.. && prisma generate --schema=./libs/prisma/schema.prisma",
    "db:migrate": "cd ../.. && prisma migrate dev --schema=./libs/prisma/schema.prisma && prisma db execute --file ./libs/prisma/ensure-vector-indexes.sql --schema=./libs/prisma/schema.prisma",
    "db:studio": "cd ../.. && prisma studio --schema=./libs/prisma/schema.prisma",
    "db:migrate:deploy": "cd ../.. && prisma migrate deploy --schema=./libs/prisma/schema.prisma && prisma db execute --file ./libs/prisma/ensure-vector-indexes.sql --schema=./libs/prisma/schema.prisma",
    "db:ensure-indexes": "cd ../.. && prisma db execute --file ./libs/prisma/ensure-vector-indexes.sql --schema=./libs/prisma/schema.prisma",
    "db:seed": "cd ../.. && ts-node --compiler-options '{\"module\":\"CommonJS\"}' ./libs/prisma/seed.ts",
    "db:reset": "cd ../.. && prisma migrate reset --schema=./libs/prisma/schema.prisma --force",
    "rbac:sync": "tsx scripts/rbac-sync.ts",
    "rbac:check": "tsx scripts/rbac-sync.ts --check",
    "rbac:check-subjects": "tsx scripts/assert-subject-coverage.ts"
  },
