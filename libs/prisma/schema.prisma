// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  output        = "../../node_modules/.prisma/client"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

generator clientWorkers {
  provider      = "prisma-client-js"
  output        = "../../apps/workers/node_modules/.prisma/client"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tenants — parent entity for all multi-tenant data
// Mirrors the TENANT#<tenantId> PK namespace from DynamoDB
// status: active|suspended — enforced via CHECK constraint in migration SQL
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String?  @unique
  status    String   @default("active") // active|suspended
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  configs TenantConfig[]
  providerModels ProviderModel[]

  @@index([status])
  @@map("tenants")
}

// TenantConfig — migrated from DynamoDB APP_TABLE (PK=TENANT#<id>, SK=CONFIG#<key>)
// Each row is one config key-value pair per tenant
model TenantConfig {
  id         String   @id @default(cuid())
  tenantId   String
  configKey  String
  data       Json
  updatedAt  DateTime @updatedAt
  updatedBy  String   @default("system")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, configKey])
  @@index([tenantId])
  @@map("tenant_configs")
}

// ProviderModel — tenant-scoped self-hosted LLM provider configurations
// Stores OpenAI-compatible endpoint configs (Ollama, vLLM, LiteLLM, LocalAI)
// Bedrock is the built-in default and is NOT stored here
model ProviderModel {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  name                String
  provider            String   @default("openai-compatible") // bedrock | openai | anthropic | ollama | vllm | lmstudio | litellm | openai-compatible
  baseUrl             String?  @map("base_url")
  apiKey              String?  @map("api_key") // legacy plaintext; new code stores secrets in `credentials`
  region              String?  @map("region") // Bedrock region
  credentials         String?  @map("credentials") // AES-256-GCM encrypted JSON: { apiKey?, accessKeyId?, secretAccessKey?, baseUrl? }
  chatModel           String?  @map("chat_model")
  embeddingModel      String?  @map("embedding_model")
  embeddingDimensions Int?     @map("embedding_dimensions")
  models              Json     // Array<{ id: string; label: string; capabilities?: string[]; maxTokens?: number }>
  isDefault           Boolean  @default(false) @map("is_default")
  isEnabled           Boolean  @default(true) @map("is_enabled")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isDefault])
  @@map("provider_models")
}

// Account — migrated from DynamoDB NucleusAppTable (PK=ACCOUNT#<AccountId>, SK=METADATA)
// Replaces GSI1 TYPE#ACCOUNT queries with proper indexed PostgreSQL columns
// tenantId is a plain string (no FK to tenants) for zero-downtime migration compatibility
model Account {
  id               String   @id @default(cuid())
  tenantId         String
  accountId        String
  name             String
  roleArn          String
  externalId       String?
  regions          String[]
  active           Boolean  @default(true)
  description      String?
  connectionStatus       String   @default("unknown")
  connectionError        String?
  lastSyncedAt           DateTime?
  lastSyncResourceCount  Int?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  createdBy        String   @default("system")
  updatedBy        String   @default("system")

  @@unique([tenantId, accountId])
  @@index([tenantId])
  @@index([tenantId, active])
  @@map("accounts")
}

// UserTenantRole — migrated from DynamoDB UsersTeamsTable (PK=USER#<sub>, SK=TENANT#<id>)
// role field uses a CHECK constraint in migration SQL (not Prisma-native) for value enforcement
// tenantId is a plain string (no FK to tenants) for zero-downtime migration compatibility
// roleId is a nullable FK to custom_roles.id — null for predefined roles (Owner/Admin/Member/Viewer)
model UserTenantRole {
  id         String      @id @default(cuid())
  userId     String
  tenantId   String
  email      String
  role       String      // keep for backward compat (predefined role name OR custom role name)
  roleId     String?     // FK to custom_roles.id — null for predefined roles
  assignedAt DateTime    @default(now())
  assignedBy String

  customRole CustomRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([roleId])
  @@map("user_tenant_roles")
}

// Schedule — migrated from DynamoDB NucleusAppTable (PK=SCHEDULE#<ScheduleId>, SK=METADATA)
// Replaces GSI1 TYPE#SCHEDULE queries with proper indexed PostgreSQL columns
// tenantId is a plain string (no FK to tenants) for zero-downtime migration compatibility
// status field uses CHECK constraint in migration SQL (not Prisma-native)
model Schedule {
  id          String   @id @default(cuid())
  tenantId    String
  scheduleId  String   // Application-level UUID (e.g., sched-*)
  accountId   String
  name        String
  description String?
  starttime   String   // HH:MM 24h format
  endtime     String   // HH:MM 24h format
  timezone    String   @default("UTC")
  days        String[] // ["Mon","Tue",...] array
  active      Boolean  @default(true)
  resources   Json     @default("[]") // Array of {id,type,name?,arn?,clusterArn?}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String   @default("system")
  updatedBy   String   @default("system")

  @@unique([tenantId, scheduleId])
  @@index([tenantId])
  @@index([tenantId, active])
  @@index([tenantId, accountId])
  @@map("schedules")
}

// ScheduleExecution — migrated from DynamoDB NucleusAppTable execution records
// expiresAt replaces DynamoDB TTL (expire_at epoch) — cleanup-expired.ts handles purging
// status field uses CHECK constraint in migration SQL (not Prisma-native)
model ScheduleExecution {
  id               String   @id @default(cuid())
  tenantId         String
  executionId      String   // Application-level ID (e.g., exec-*)
  scheduleId       String
  accountId        String
  status           String   // pending|running|success|failed|partial
  executionTime    DateTime
  resourcesStarted Int      @default(0)
  resourcesStopped Int      @default(0)
  resourcesFailed  Int      @default(0)
  duration         Int?     // seconds
  errorMessage     String?
  details          Json?    // free-form execution details
  scheduleMetadata Json?    // grouped per-resource-type execution records
  expiresAt        DateTime // TTL replacement — set to now + 90 days on insert

  @@unique([tenantId, executionId])
  @@index([tenantId])
  @@index([tenantId, scheduleId])
  @@index([tenantId, status])
  @@index([expiresAt]) // for cleanup-expired.ts
  @@map("schedule_executions")
}

// TargetedResource — migrated from DynamoDB NucleusAppTable (PK=SCHEDULE#<id>, SK=RESOURCE#<arn>)
// Replaces composite key pattern with proper relational columns
// resourceType field uses CHECK constraint in migration SQL (not Prisma-native)
model TargetedResource {
  id           String   @id @default(cuid())
  tenantId     String
  scheduleId   String
  resourceArn  String
  resourceType String   // ec2|ecs|rds|asg|docdb
  resourceId   String
  name         String?
  clusterArn   String?  // ECS only
  createdAt    DateTime @default(now())

  @@unique([tenantId, scheduleId, resourceArn])
  @@index([tenantId, scheduleId])
  @@map("targeted_resources")
}

// AuditLog — migrated from DynamoDB NucleusAuditTable (immutable logs with TTL)
// expiresAt replaces DynamoDB TTL (expire_at epoch) — cleanup-expired.ts handles purging
// status and severity fields use CHECK constraints in migration SQL (not Prisma-native)
// source: platform (user-initiated) | system (background jobs) | agent (AI agent) | external (webhooks)
model AuditLog {
  id                 String   @id @default(cuid())
  tenantId           String
  logId              String   // Application-level ID (e.g., log-*)
  timestamp          DateTime @default(now())
  eventType          String   // domain.entity.action (e.g., account.account.created)
  action             String
  user               String   @default("system")
  userType           String   @default("system") // system|user|admin|external
  resource           String?
  resourceType       String?
  resourceId         String?
  status             String   @default("info") // success|error|warning|info
  severity           String   @default("info") // low|medium|high|critical|info
  details            String?
  metadata           Json?
  ipAddress          String?
  userAgent          String?
  sessionId          String?
  correlationId      String?
  executionId        String?
  region             String?
  accountId          String?
  duration           Int?
  errorCode          String?
  source             String   @default("system") // platform|system|agent|external
  expiresAt          DateTime // TTL — computed from retentionDays at insert time

  // Compliance fields (SOC 2 / NIST AU-3)
  changeSet          Json?    // { before: {...}, after: {...} } for update events
  requestId          String?  // X-Request-Id header for request tracing
  apiRoute           String?  // e.g., "POST /api/accounts"
  httpMethod         String?  // GET, POST, PUT, DELETE, PATCH
  dataClassification String?  // pii, credentials, infrastructure, config
  retentionDays      Int      @default(90) // Configurable per event type

  @@unique([tenantId, logId])
  @@index([tenantId])
  @@index([tenantId, eventType])
  @@index([tenantId, user])
  @@index([tenantId, timestamp])
  @@index([tenantId, source, timestamp]) // "show me all system events today"
  @@index([tenantId, resourceType, resourceId]) // "show me all events for this schedule"
  @@index([expiresAt]) // for cleanup-expired.ts
  @@map("audit_logs")
}

// KnowledgeBase — migrated from DynamoDB NucleusAppTable KB entities (KB-01)
// status field uses CHECK constraint in migration SQL (not Prisma-native)
// tenantId is a plain string (no FK to tenants) for zero-downtime migration compatibility
model KnowledgeBase {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  status          String   @default("active") // active|inactive — CHECK in migration SQL
  vectorCount     Int      @default(0)
  dataSourceCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?

  dataSources DataSource[]

  @@index([tenantId])
  @@map("knowledge_bases")
}

// DataSource — migrated from DynamoDB NucleusAppTable data source entities (KB-01)
// sourceType and status fields use CHECK constraints in migration SQL (not Prisma-native)
model DataSource {
  id              String    @id @default(cuid())
  tenantId        String
  knowledgeBaseId String
  name            String
  sourceType      String    // file-upload|s3-bucket|confluence|bitbucket — CHECK in migration SQL
  status          String    @default("pending") // pending|syncing|synced|error — CHECK in migration SQL
  config          Json      @default("{}")
  vectorCount     Int       @default(0)
  vectorKeys      String[]  @default([])
  lastSyncAt          DateTime?
  lastSyncError       String?   // user-friendly short error message
  lastErrorMessage    String?   // user-friendly short error message (alias for UI display)
  lastErrorDetail     String?   // full error message + stack trace
  createdAt           DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([knowledgeBaseId])
  @@map("data_sources")
}

// KbDocumentChunk — stores document chunk embeddings for KB semantic search
// Replaces S3 Vectors knowledge-base-embeddings index
// Uses pgvector for similarity search (same pattern as inventory_resources.embedding)
// tenantId scopes all queries; knowledgeBaseId + dataSourceId link to parent entities
model KbDocumentChunk {
  id              String   @id @default(cuid())
  tenantId        String
  knowledgeBaseId String
  dataSourceId    String
  vectorKey       String   @unique  // e.g. kb_{kbId}_{dsId}_{docId}_{chunkIdx}_{hash}
  documentName    String
  sourceType      String
  chunkIndex      Int
  totalChunks     Int
  contentHash     String
  textContent     String   // chunk text (up to ~2000 chars)
  metadata        Json     @default("{}")  // extra metadata (s3Key, confluencePageId, etc.)
  embedding       Unsupported("vector(1024)")
  createdAt       DateTime @default(now())

  @@index([tenantId, knowledgeBaseId])
  @@index([tenantId, dataSourceId])
  @@index([vectorKey])
  @@map("kb_document_chunks")
}

// InventoryResource — migrated from DynamoDB inventory scan results (KB-05)
// Flat table with JSONB columns for tags and metadata (D-01, D-02, D-03, D-04)
// search_vector is auto-populated via trigger (see 20260405_add_inventory_search_vector migration)
// tenantId is a plain string (no FK to tenants) for zero-downtime migration compatibility
model InventoryResource {
  id           String   @id @default(cuid())
  tenantId     String
  accountId    String
  region       String
  resourceType String
  resourceId   String
  name         String?
  status       String?
  tags         Json     @default("{}")
  metadata     Json     @default("{}")
  jobRunId     String?
  discoveredAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  searchVector Unsupported("tsvector")?

  @@unique([tenantId, accountId, resourceType, resourceId])
  @@index([tenantId, resourceType])
  @@index([tenantId, accountId])
  @@map("inventory_resources")
}

// InventorySyncStatus — tracks per-scan metadata (replaces DynamoDB SYNC#INVENTORY pattern)
// Written by discovery Lambda after each scan run
model InventorySyncStatus {
  id              String   @id @default(cuid())
  scanId          String   @unique
  tenantId        String   @default("")
  totalResources  Int      @default(0)
  accountsSynced  Int      @default(0)
  status          String   @default("completed")
  errors          String[] @default([])
  syncedAt        DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([syncedAt])
  @@index([tenantId, syncedAt])
  @@map("inventory_sync_status")
}

// AgentOpsRun — migrated from DynamoDB AgentOpsTable run records (AOPS-01)
// source, status, mode fields use CHECK constraints in migration SQL (not Prisma-native)
// expiresAt replaces DynamoDB TTL (30-day retention)
// tenantId is a plain string (no FK to tenants) for zero-downtime migration compatibility
model AgentOpsRun {
  id              String    @id @default(cuid())
  tenantId        String
  runId           String
  source          String    // slack|jira|api|scheduled — CHECK in migration SQL
  status          String    @default("queued") // queued|in_progress|awaiting_input|awaiting_approval|completed|failed|cancelled
  taskDescription String
  mode            String    @default("plan") // plan|fast
  accountId       String?
  accountName     String?
  selectedSkill   String?
  autoApprove     Boolean   @default(false)
  model           String?
  threadId        String
  mcpServerIds    String[]  @default([])
  trigger         Json      @default("{}")
  result          Json?
  clarification   Json?
  approvalRequest Json?
  error           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?
  durationMs      Int?
  expiresAt       DateTime  // TTL replacement — 30 days

  events AgentOpsEvent[]

  @@unique([tenantId, runId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, source])
  @@index([source, createdAt])
  @@index([expiresAt])
  @@map("agent_ops_runs")
}

// AgentOpsEvent — migrated from DynamoDB AgentOpsTable event records (AOPS-01)
// eventType field uses CHECK constraint in migration SQL (not Prisma-native)
// expiresAt replaces DynamoDB TTL (30-day retention)
model AgentOpsEvent {
  id         String   @id @default(cuid())
  tenantId   String
  runId      String
  eventType  String   // planning|execution|tool_call|tool_result|reflection|revision|final|error
  node       String
  content    String?
  toolName   String?
  toolArgs   Json?
  toolOutput String?
  metadata   Json?
  createdAt  DateTime @default(now())
  expiresAt  DateTime // TTL replacement — 30 days

  run AgentOpsRun @relation(fields: [tenantId, runId], references: [tenantId, runId], onDelete: Cascade)

  @@index([tenantId, runId])
  @@index([runId, createdAt])
  @@index([expiresAt])
  @@map("agent_ops_events")
}

// ScheduledTask — migrated from DynamoDB AgentOpsTable scheduled task records (AOPS-01)
// taskStatus and mode fields use CHECK constraints in migration SQL (not Prisma-native)
// tenantId is a plain string (no FK to tenants) for zero-downtime migration compatibility
model ScheduledTask {
  id             String    @id @default(cuid())
  tenantId       String
  taskId         String
  name           String
  description    String
  cronExpression String
  timezone       String
  taskStatus     String    @default("active") // active|paused|deleted — CHECK in migration SQL
  mode           String    @default("plan") // plan|fast
  autoApprove    Boolean   @default(false)
  model          String?
  accountId      String?
  accountName    String?
  mcpServerIds   String[]  @default([])
  notification   Json      @default("{}")
  lastRunId      String?
  lastRunAt      DateTime?
  lastRunStatus  String?
  nextRunAt      DateTime?
  runCount       Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String

  @@unique([tenantId, taskId])
  @@index([tenantId])
  @@index([tenantId, taskStatus])
  @@map("scheduled_tasks")
}

// ScheduledTaskLock — distributed lock for scheduled task execution (AOPS-04)
// ON CONFLICT on (taskId, scheduledAt) enables atomic lock acquisition
// expiresAt enables automatic lock expiry cleanup (1 hour TTL)
model ScheduledTaskLock {
  id          String   @id @default(cuid())
  taskId      String
  scheduledAt String
  acquiredAt  DateTime @default(now())
  expiresAt   DateTime // 1 hour TTL

  @@unique([taskId, scheduledAt])
  @@index([expiresAt])
  @@map("scheduled_task_locks")
}

enum MemoryKind {
  SEMANTIC
  EPISODIC
  PROCEDURAL
}

// AgentMemory — long-term semantic memory for AI agents (LANG-03)
// Uses pgvector for similarity search with Bedrock Titan v2 embeddings (1024-dim)
// embedding column uses Unsupported() — raw SQL for vector queries (Prisma has no native pgvector support)
// expiresAt: 90-day TTL (same cleanup pattern as other tables)
model AgentMemory {
  id             String                       @id @default(cuid())
  tenantId       String
  userId         String
  namespace      String
  key            String
  value          Json
  kind           MemoryKind                   @default(SEMANTIC)
  embedding      Unsupported("vector(1024)")?
  sourceThreadId String?
  supersededById String?
  supersededAt   DateTime?
  lastAccessedAt DateTime?
  accessCount    Int                          @default(0)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  expiresAt      DateTime // 90-day TTL

  @@index([tenantId, namespace, key])
  @@index([tenantId, userId])
  @@index([tenantId, kind])
  @@index([expiresAt])
  @@map("agent_memories")
}

// AgentWorkingMemory — per-thread in-session scratchpad + rolling summary (Phase 1).
// Live source of truth is the LangGraph checkpoint; this table is a durable mirror
// written on each compaction. No embedding (this is live context, not searched).
model AgentWorkingMemory {
  id             String   @id @default(cuid())
  tenantId       String
  threadId       String
  runningSummary String   @db.Text
  scratchpad     Json
  tokenCount     Int      @default(0)
  turnCount      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  expiresAt      DateTime

  @@unique([tenantId, threadId])
  @@index([expiresAt])
  @@map("agent_working_memory")
}

// ChatMessage — chat session history for AI agent threads (LANG-02)
// Replaces DynamoDBChatMessageHistory from @farukada/aws-langgraph-dynamodb-ts
// expiresAt: 30-day TTL
model ChatMessage {
  id        String   @id @default(cuid())
  tenantId  String
  sessionId String
  role      String   // human|ai|system|tool
  content   String
  metadata  Json?
  createdAt DateTime @default(now())
  expiresAt DateTime // 30-day TTL

  @@index([tenantId, sessionId, createdAt])
  @@index([expiresAt])
  @@map("chat_messages")
}

// ChatSession — thread metadata for AI agent chat sessions
// Tracks thread title, owner, timestamps for sidebar listing
model ChatSession {
  id        String   @id @default(cuid())
  tenantId  String
  sessionId String   @unique // thread ID (tenantId:userId:timestamp format)
  userId    String
  title     String   @default("New Chat")
  model     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, updatedAt])
  @@map("chat_sessions")
}

// KbChatSession — saved Knowledge Base "Ask AI" chat sessions (tenant-shared)
// Isolated from agent ChatSession so the agent sidebar (/api/threads) never mixes in KB chats.
// knowledgeBaseId: null = "All Knowledge Bases". userId is creator attribution only.
model KbChatSession {
  id              String   @id @default(cuid())
  tenantId        String
  sessionId       String   @unique // tenantId:userId:timestamp
  userId          String
  title           String   @default("New Chat")
  knowledgeBaseId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, updatedAt])
  @@map("kb_chat_sessions")
}

// KbChatMessage — message history for KB "Ask AI" sessions
// role: user|assistant. metadata stores retrieved sources ({ sources?: KBSource[] }).
// expiresAt: 30-day TTL (same cleanup pattern as ChatMessage).
model KbChatMessage {
  id        String   @id @default(cuid())
  tenantId  String
  sessionId String
  role      String   // user|assistant
  content   String
  metadata  Json?
  createdAt DateTime @default(now())
  expiresAt DateTime // 30-day TTL

  @@index([tenantId, sessionId, createdAt])
  @@index([expiresAt])
  @@map("kb_chat_messages")
}

// CustomRole — preset (global) and tenant-scoped custom roles with per-module permission sets (Phase 13 RBAC)
// type: 'preset' = global (tenantId=null), 'custom' = tenant-scoped
// permissions column stores PermissionSet shape: { Accounts: ['read','update'], ... }
// level is auto-computed via getAutoLevel() — 1=Viewer, 2=Member, 3=Admin, 4=Owner
// Partial unique indexes enforced via raw SQL in migration (Prisma can't express partial indexes)
model CustomRole {
  id          String   @id @default(cuid())
  tenantId    String?
  name        String
  type        String   @default("custom") // 'preset' | 'custom'
  permissions Json     // PermissionSet shape: { Accounts: ['read','update'], ... }
  level       Int      @default(1) // Auto-computed: 1=Viewer, 2=Member, 3=Admin, 4=Owner
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String

  userRoles   UserTenantRole[]

  @@index([tenantId])
  @@index([type])
  @@map("custom_roles")
}

// Invitation — tracks user invitations sent via Cognito AdminCreateUser (Phase 16)
// status: pending|accepted|revoked|expired — enforced via CHECK constraint in migration SQL
// Tenant-scoped: every query must include tenantId (enforced by getTenantClient middleware)
model Invitation {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  role      String
  invitedBy String
  status    String   @default("pending") // pending|accepted|revoked|expired
  createdAt DateTime @default(now())
  expiresAt DateTime // 7 days from creation (Cognito TemporaryPasswordValidityDays)

  @@unique([tenantId, email, status]) // prevent duplicate pending invites
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([email])
  @@map("invitations")
}

// Certificate — logical TLS certificate (domain/name) for multi-account management.
// Certificate Manager is the source of truth; all sync is unidirectional (S3 → ACM).
// Material + validity live on CertificateVersion (one active at a time). The cached
// columns below mirror the active version so list/detail reads stay flat.
// status: active | expiring | expired | no_material — derived from the active version.
//
// NOTE (Phase A migration): the legacy material columns (s3*Key, associatedAccountIds,
// tags) are retained for cutover and dropped in a later migration.
model Certificate {
  id                   String   @id @default(cuid())
  tenantId             String
  name                 String
  domainName           String
  activeVersionId      String? // FK → CertificateVersion.id (app-enforced; active version cannot be deleted)
  status               String   @default("active") // active | expiring | expired | no_material (cached from active version)
  issuer               String? // cached from active version
  notBefore            DateTime?
  notAfter             DateTime? // cached from active version — nullable once a cert may have no material
  // --- legacy columns (Phase A: kept for cutover, removed in a later migration) ---
  s3BodyKey            String?
  s3ChainKey           String?
  s3PrivateKeyKey      String?
  associatedAccountIds String[] @default([])
  tags                 Json     @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  createdBy            String

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, notAfter])
  @@map("certificates")
}

// CertificateVersion — one row per uploaded material set. Exactly one isActive=true per
// certificate (enforced by a partial unique index in the migration + an activation
// transaction in the repository). Material bytes live in S3; DB holds the keys.
model CertificateVersion {
  id              String    @id @default(cuid())
  tenantId        String
  certificateId   String
  version         Int
  isActive        Boolean   @default(false)
  issuer          String?
  notBefore       DateTime?
  notAfter        DateTime
  fingerprint     String? // sha256 hex of the cert body; nullable (lazy-computed for backfilled v1)
  serialNumber    String?
  s3BodyKey       String
  s3ChainKey      String?
  s3PrivateKeyKey String
  status          String    @default("active") // active | expiring | expired
  uploadedAt      DateTime  @default(now())
  uploadedBy      String

  @@unique([tenantId, certificateId, version])
  @@index([tenantId, certificateId])
  @@map("certificate_versions")
}

// CertificateDeployment — live per-account linkage discovered from ACM (replaces the old
// inventory correlation + associatedAccountIds). One row per (certificate, account, region).
// region is NOT NULL; backfilled rows use the 'unknown' sentinel and are reconciled by Discover.
model CertificateDeployment {
  id                String    @id @default(cuid())
  tenantId          String
  certificateId     String
  accountId         String
  region            String
  acmArn            String?
  acmDomainName     String?
  acmNotAfter       DateTime?
  acmStatus         String? // ISSUED | EXPIRED | ... (from ACM DescribeCertificate)
  deployedVersionId String?
  linkState         String    @default("discovered") // discovered | deployed | missing | error
  inUseByCount      Int       @default(0)
  lastScannedAt     DateTime?
  lastDeployedAt    DateTime?

  @@unique([tenantId, certificateId, accountId, region])
  @@index([tenantId, certificateId])
  @@map("certificate_deployments")
}

// CertificateExecution — execution history of cross-account operations (mirrors ScheduleExecution).
// expiresAt drives TTL cleanup via cleanup-expired.ts.
model CertificateExecution {
  id            String    @id @default(cuid())
  tenantId      String
  certificateId String
  executionId   String
  operation     String // discover | deploy | reimport
  versionId     String?
  accountId     String?
  region        String?
  status        String // running | success | failed | partial
  acmArn        String?
  message       String?
  details       Json? // per-account results for discover
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  duration      Int? // seconds
  triggeredBy   String
  expiresAt     DateTime

  @@unique([tenantId, executionId])
  @@index([tenantId, certificateId, startedAt])
  @@index([expiresAt])
  @@map("certificate_executions")
}

// === NextAuth Prisma Adapter Models ===
// Per D-05: database sessions (not JWT) for suspension enforcement
// @@map to auth_* tables to avoid collision with existing Account model

model AuthUser {
  id             String        @id @default(cuid())
  email          String        @unique
  emailVerified  DateTime?
  name           String?
  image          String?
  passwordHash   String?       // null for Cognito-only users
  isSuperAdmin   Boolean       @default(false)
  failedAttempts  Int           @default(0)
  lockedUntil     DateTime?
  activeTenantId  String?   @map("active_tenant_id")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  accounts       AuthAccount[]
  sessions       AuthSession[]

  @@map("auth_users")
}

model AuthAccount {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("auth_accounts")
}

model AuthSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
// RightSizingRecommendation — RS-001 (Right Sizing module)
// Per-resource right-sizing recommendation generated by the CloudWatch analysis engine.
// tenantId is a plain string (no FK) consistent with other migrated models.
// status reserves `applied` for a future automated-resize phase (not implemented in v1).
model RightSizingRecommendation {
  id                      String    @id @default(cuid())
  tenantId                String
  accountId               String
  region                  String
  resourceType            String // matches inventory_resources.resourceType: ec2_instances | rds_db_instances | ec2_volumes | autoscaling_auto_scaling_groups
  resourceId              String
  name                    String?
  finding                 String // over_provisioned | under_provisioned | idle | optimized
  currentConfig           Json      @default("{}")
  recommendedConfig       Json? // null when finding = optimized
  metricsSummary          Json      @default("{}")
  lookbackDays            Int       @default(14)
  currency                String    @default("USD")
  currentMonthlyCost      Float?
  recommendedMonthlyCost  Float?
  estimatedMonthlySavings Float     @default(0)
  confidence              Float     @default(0) // 0..1
  riskLevel               String    @default("medium") // low | medium | high
  rationale               String    @default("")
  source                  String    @default("cloudwatch")
  status                  String    @default("open") // open | approved | dismissed | snoozed | applied(reserved)
  snoozeUntil             DateTime?
  reviewedBy              String?
  reviewedAt              DateTime?
  generatedByRunId        String?
  generatedAt             DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([tenantId, accountId, resourceType, resourceId])
  @@index([tenantId, finding])
  @@index([tenantId, status])
  @@index([tenantId, estimatedMonthlySavings])
  @@map("right_sizing_recommendations")
}

// RightSizingRun — RS-001 (Right Sizing module)
// Tracks each per-tenant right-sizing analysis run (mirrors InventorySyncStatus).
model RightSizingRun {
  id                       String    @id @default(cuid())
  tenantId                 String
  status                   String    @default("queued") // queued | running | completed | failed
  trigger                  String    @default("schedule") // schedule | manual
  lookbackDays             Int       @default(14)
  accountsScanned          Int       @default(0)
  resourcesAnalyzed        Int       @default(0)
  recommendationsGenerated Int       @default(0)
  totalEstimatedSavings    Float     @default(0)
  errors                   Json      @default("[]")
  startedAt                DateTime  @default(now())
  finishedAt               DateTime?
  expiresAt                DateTime?

  @@index([tenantId, startedAt])
  @@map("right_sizing_runs")
}

// PricingCatalogEntry — RS-005 (Right Sizing module)
// Cached AWS on-demand pricing + type metadata, refreshed by a weekly worker job.
// GLOBAL reference data — NOT tenant-scoped (the one model exempt from getTenantClient()).
model PricingCatalogEntry {
  id                String   @id @default(cuid())
  region            String
  serviceCode       String // AmazonEC2 | AmazonRDS | AmazonEBS
  resourceClass     String // instance type, db instance class, or volume type
  attributes        Json     @default("{}") // { vcpu, memGiB, family, storage, ... }
  pricePerHour      Float?
  pricePerGiBMonth  Float?
  pricePerIopsMonth Float?
  currency          String   @default("USD")
  refreshedAt       DateTime @default(now())

  @@unique([region, serviceCode, resourceClass])
  @@index([serviceCode, region])
  @@map("pricing_catalog")
}

