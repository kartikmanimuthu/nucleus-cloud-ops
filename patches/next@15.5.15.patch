+                    // this (dist/server/web/sandbox/sandbox.js) — this makes the Node.js
+                    // middleware path match. Rejections are swallowed on purpose: a client
+                    // abort mid-upload must surface from the route handler (which handles it),
+                    // not as a 500 thrown out of this finally block.
+                    await requestData.body.finalize().catch(()=>{});
                 }
             }
         } else {
