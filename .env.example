# ============================================================================
# Nucleus Cloud Ops — single root .env template (copy to .env and fill in)
# ----------------------------------------------------------------------------
# This is the ONLY env template in the repo. Copy it to the repo root:
#   cp .env.example .env
# Both apps load the root .env:
#   - web-ui: apps/web-ui/next.config.mjs calls dotenv.config({ path: '../../.env' })
#   - workers: apps/workers dev/start scripts use --env-file=../../.env
#   - prisma (web-ui db:* scripts): run from repo root (cd ../.. &&), so they read this file
# Required for local dev: DATABASE_URL, AWS_REGION, NEXTAUTH_SECRET,
#   COGNITO_USER_POOL_ID, COGNITO_APP_CLIENT_ID, COGNITO_APP_CLIENT_SECRET
# ============================================================================

# ============================================================================
# Database — Local PostgreSQL (docker compose up -d postgres)
# ============================================================================
DATABASE_URL=postgresql://nucleus:nucleus_dev@localhost:5432/nucleus?connection_limit=10
# RDS via SSM tunnel:
# DATABASE_URL=postgresql://nucleus_admin:<pw>@localhost:5432/nucleus?sslmode=require&uselibpqcompat=true

# ============================================================================
# AWS
# ============================================================================
AWS_REGION=ap-south-1
NEXT_PUBLIC_AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1
AWS_PROFILE=STX-CLOUD-PLATFORM
AWS_ACCOUNT_ID=123456789012
HUB_ACCOUNT_ID=123456789012
NEXT_PUBLIC_HUB_ACCOUNT_ID=123456789012

# ============================================================================
# Authentication — Cognito + NextAuth
# ============================================================================
COGNITO_USER_POOL_ID=ap-south-1_example
COGNITO_APP_CLIENT_ID=example_client_id
COGNITO_APP_CLIENT_SECRET=example_secret
COGNITO_ISSUER=https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_example

NEXTAUTH_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars

# ============================================================================
# S3 — unified bucket (all features use namespaced prefixes)
# ============================================================================
APP_BUCKET_NAME=nucleus-cloud-ops-123456789012-ap-south-1
# Optional: serve assets via CloudFront instead of direct S3
# ASSETS_CDN_URL=https://your-cloudfront-domain.cloudfront.net

# ============================================================================
# AI / Bedrock
# ============================================================================
BEDROCK_MODEL_ID=amazon.titan-embed-text-v2:0
ASK_AI_GENERATION_MODEL=global.anthropic.claude-sonnet-4-6

# ============================================================================
# Horizontal Worker (ECS task-spawning) config — workers only
# ============================================================================
WORKER_ARCH=vertical
HORIZONTAL_CLUSTER_ARN=arn:aws:ecs:region:account:cluster/your-cluster
HORIZONTAL_TASK_DEF_ARN=arn:aws:ecs:region:account:task-definition/your-ephemeral-worker-task
HORIZONTAL_SUBNETS=subnet-aaaa,subnet-bbbb
HORIZONTAL_SECURITY_GROUP=sg-xxxxxxxx
HORIZONTAL_TASK_TIMEOUT_MS=900000
HORIZONTAL_POLL_INTERVAL_MS=2000

# ============================================================================
# Discovery tuning
# ============================================================================
CONCURRENT_REGIONS=5
CONCURRENT_SERVICES=10
# Optional override for the discovery scan config. Defaults to the scanfile.json
# shipped beside the discovery module; a relative value is resolved against that
# module dir (not the process cwd). Leave unset unless pointing at a custom file.
# SCANFILE_PATH=/etc/nucleus/scanfile.json

# ============================================================================
# Misc
# ============================================================================
DATA_DIR=/tmp
NODE_ENV=development
USE_PG_SCHEDULES=true
PORT=3001
LOG_LEVEL=debug
SERVICE_NAME=workers
DEFAULT_TENANT_ID=org-default

# Working memory (Phase 1) — in-session context compaction for long-running agents.
# When over WORKING_MEMORY_TOKEN_BUDGET estimated tokens, older turns are folded into
# a rolling summary + scratchpad (via the reflector model) so multi-hour runs survive
WORKING_MEMORY_TOKEN_BUDGET=60000
WORKING_MEMORY_KEEP_RECENT=8

# Save-time memory reconciliation (Phase 2) — dedup/contradiction resolution via an
# LLM judge before writing. Set false to restore blind upserts (legacy behavior).

# Episodic memory (Phase 3) — capture one distilled episode per tool-using run and
# replay similar past episodes as few-shot experience at task start.

# Procedural memory (Phase 4) — learn operating rules from corrections/failures and
# inject them as '### Operating rules (learned)'; promote matured rules to Skills (human-approved).

# Hermes autonomy + observability
# MEMORY_LOG_VERBOSE: print full injected memoryContext blocks (summary lines are always on).
# (Auto skill selection/loading has no env flag — it is always available and toggled per-session via the "Auto skills" switch in the AIOps console.)
MEMORY_LOG_VERBOSE=true

# ============================================================================
# Optional integrations
# ============================================================================

# Langfuse — LLM tracing. Set LANGFUSE_ENABLED=true and fill keys to activate.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...

# Slack signing secret and bot token are now stored per tenant via
# Settings → Channels → Slack (tenant config key: agent-ops-slack).

# Jira
# JIRA_WEBHOOK_SECRET=your-jira-webhook-secret
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_USER_EMAIL=bot@your-org.com
# JIRA_API_TOKEN=your-atlassian-api-token

# Tavily (web search tool for AI agent)
# TAVILY_API_KEY=tvly-...

# LLM audit logging (logs every Bedrock call — dev only)
# LLM_AUDIT=true

# Skip audit DB writes in local dev
# SKIP_AUDIT_LOGGING=true

# AI Ops sub-agents (Layer B). The feature is UI-driven: each tenant enables it
# and tunes its budget from the AI Ops console settings — no env var needed.
# SUBAGENTS_ENABLED=false is an EMERGENCY deployment-wide kill-switch (tenant
# settings cannot re-enable while it is set); leave it unset in normal operation.
# The SUBAGENT_MAX_* vars are CEILINGS that lower (never raise) the built-in
# maximums a tenant may configure.
# SUBAGENTS_ENABLED=false
# SUBAGENT_MAX_CONCURRENCY=6
# SUBAGENT_MAX_PER_RUN=16
# SUBAGENT_MAX_TOKENS_PER_RUN=1000000
# SUBAGENT_MAX_ITERATIONS=16
# SUBAGENT_TIMEOUT_MS=300000
# Max concurrent shell subprocesses from execute_command (Layer A).
# TOOL_CONCURRENCY=6

# Internal worker<->web-ui auth key (must match across both apps).
# REQUIRED for the agent-ops scheduler to work: the workers process sends this
# as x-internal-key when triggering a scheduled task, and web-ui only trusts the
# call when this is set AND matches. If unset, the worker fails closed (the tick
# throws + dead-letters) and no scheduled run ever fires. Use any value locally;
# in prod it is injected from Secrets Manager.
INTERNAL_API_KEY=internal-worker-key

# Maintenance / one-off scripts
# DRY_RUN=true
# BATCH_SIZE=100
# CONCURRENCY=5

# Gateway channel adapters
# DISCORD_PUBLIC_KEY=...
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_SECRET_TOKEN=...
# WEBHOOK_SECRET=...

# Deep agent — MongoDB / DocumentDB (only needed if using deep-agent feature)
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB_NAME=nucleus
# DOCDB_ENDPOINT=your-docdb-cluster.cluster-xxx.ap-south-1.docdb.amazonaws.com
# DOCDB_PORT=27017
# DOCDB_USERNAME=nucleus
# DOCDB_PASSWORD=your-password
# DEEP_AGENT_DB_NAME=nucleus
# DEEP_AGENT_LOG_LEVEL=debug
# Iteration budget for autonomous Agent Ops runs (scheduled/channel-triggered).
# Separate from the interactive chat agents (MAX_ITERATIONS=30). Default 150 when unset.
# AGENT_OPS_MAX_ITERATIONS=150
