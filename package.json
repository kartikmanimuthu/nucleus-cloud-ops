{
  "name": "@nucleus/source",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise-grade AWS Cloud Operations Platform with AI Ops & GenAI DevOps Agent built on AWS Bedrock for Multi-Account Management.",
  "author": "kartikmanimuthu@gmail.com",
  "packageManager": "bun@1.2.12",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "libs/*",
    "infra/*"
  ],
  "scripts": {
    "setup": "[ -f .env ] || cp .env.example .env && bun install && bun run prepare && prisma migrate deploy --schema=./libs/prisma/schema.prisma",
    "prepare": "prisma generate --schema=./libs/prisma/schema.prisma",
    "dev": "nx serve web-ui",
    "dev:workers": "nx serve workers",
    "dev:all": "nx run-many -t serve -p web-ui,workers --parallel",
    "build": "nx run-many -t build --all",
    "build:web": "nx build web-ui",
    "build:workers": "nx build workers",
    "test": "nx run-many -t test --all",
    "test:web": "nx test web-ui",
    "test:workers": "nx test workers",
    "lint": "nx run-many -t lint --all",
    "typecheck": "nx run-many -t typecheck --all",
    "affected:typecheck": "nx affected -t typecheck",
    "affected:test": "nx affected -t test",
    "affected:build": "nx affected -t build",
    "verify": "bun run affected:typecheck && bun run affected:test && bun run affected:build",
    "e2e": "nx e2e web-ui-e2e",
    "e2e:ui": "nx e2e:ui web-ui-e2e",
    "codegen": "nx codegen web-ui-e2e",
    "graph": "nx graph"
  },
  "devDependencies": {
    "@aws-sdk/client-s3vectors": "^3.1019.0",
    "@nx/eslint-plugin": "^21.0.0",
    "@nx/js": "^21.0.0",
    "@nx/vite": "^21.0.0",
    "@playwright/test": "^1.58.2",
    "@types/aws-lambda": "^8.10.160",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.5.4",
    "esbuild": "^0.27.3",
    "jest": "^29.7.0",
    "nx": "^21.0.0",
    "prisma": "^5.22.0",
    "puppeteer": "^24.38.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "~5.6.2"
  },
  "dependencies": {
    "@aws-sdk/client-acm": "^3.1040.0",
    "@aws-sdk/client-bedrock-runtime": "^3.991.0",
    "@aws-sdk/client-dynamodb": "^3.821.0",
    "@aws-sdk/client-s3": "^3.991.0",
    "@aws-sdk/lib-dynamodb": "^3.821.0",
    "@prisma/client": "^5.22.0",
    "cheerio": "^1.2.0",
    "dayjs": "^1.11.10",
    "dotenv": "^17.3.1",
    "jwt-decode": "^4.0.0",
    "next-auth": "^4.24.11",
    "source-map-support": "^0.5.21"
  }
}