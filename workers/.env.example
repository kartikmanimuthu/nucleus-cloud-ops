# ============================================================================
# Database
# ============================================================================
# Local dev: docker compose up -d postgres
DATABASE_URL=postgresql://nucleus:nucleus_dev@localhost:5432/nucleus?connection_limit=3

# ============================================================================
# AWS
# ============================================================================
AWS_REGION=ap-south-1
CROSS_ACCOUNT_ROLE_NAME=NucleusAccess

# ============================================================================
# S3 — unified bucket
# ============================================================================
APP_BUCKET_NAME=nucleus-cloud-ops-123456789012-ap-south-1
# Legacy alias — points to the same bucket
KB_STAGING_BUCKET_NAME=nucleus-cloud-ops-123456789012-ap-south-1

# S3 Vectors (disabled until Phase 11 — leave empty)
KB_VECTOR_BUCKET_NAME=
KB_VECTOR_INDEX_NAME=knowledge-base-embeddings

# ============================================================================
# AI / Bedrock
# ============================================================================
BEDROCK_MODEL_ID=amazon.titan-embed-text-v2:0

# ============================================================================
# Worker config
# ============================================================================
NODE_ENV=development
LOG_LEVEL=info
WORKER_ARCH=horizontal

# SNS (cross-service notifications)
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:nucleus-cloud-ops-sns-topic

# ============================================================================
# Horizontal executor — ECS task dispatch (injected by Pulumi in prod)
# ============================================================================
HORIZONTAL_CLUSTER_ARN=arn:aws:ecs:ap-south-1:123456789012:cluster/nucleus-cloud-ops-ecs-cluster
HORIZONTAL_TASK_DEF_ARN=arn:aws:ecs:ap-south-1:123456789012:task-definition/nucleus-cloud-ops-ephemeral-worker-task:1
HORIZONTAL_SUBNETS=subnet-xxxxxxxx,subnet-yyyyyyyy
HORIZONTAL_SECURITY_GROUP=sg-xxxxxxxx
HORIZONTAL_TASK_TIMEOUT_MS=900000

# ============================================================================
# Feature flags
# ============================================================================
USE_PG_SCHEDULES=true
USE_PG_KB=true

# ============================================================================
# Optional
# ============================================================================

# Agent-ops scheduler — calls web-ui API to trigger agent runs
# WEB_UI_BASE_URL=http://localhost:3001
# PORT=3001
# INTERNAL_API_KEY=internal-worker-key

# Discovery tuning (defaults: 5 regions, 10 services concurrently)
# CONCURRENT_REGIONS=5
# CONCURRENT_SERVICES=10

# Local discovery runner — path to a scanfile.json for offline testing
# SCANFILE_PATH=./src/jobs/discovery/scanfile.json
