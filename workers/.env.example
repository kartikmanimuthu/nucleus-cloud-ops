# ─── PostgreSQL (pg-boss + scheduler + kb-sync) ───────────────────────────────
# Connection string for the PostgreSQL database used by pg-boss and all workers.
DATABASE_URL="postgresql://user:password@localhost:5432/nucleus"

# ─── AWS ──────────────────────────────────────────────────────────────────────
# AWS region for all SDK clients (STS, EC2, RDS, ECS, Bedrock, S3, DynamoDB).
AWS_REGION="ap-south-1"
# Optional: named AWS profile (uses default credential chain if omitted).
# AWS_PROFILE="PLATFORM-ADMIN"

# ─── DynamoDB tables (used when USE_PG_SCHEDULES=false / USE_PG_KB=false) ─────
# NucleusAppTable — single-table design for schedules, accounts, KB data sources.
APP_TABLE_NAME="cost-optimization-scheduler-app-table"
# NucleusAuditTable — immutable audit log with TTL.
AUDIT_TABLE_NAME="cost-optimization-scheduler-audit-table"

# ─── Feature flags ────────────────────────────────────────────────────────────
# "true"  → scheduler reads schedules/accounts/audit from PostgreSQL
# "false" → scheduler reads from DynamoDB (default, safe for gradual migration)
USE_PG_SCHEDULES="false"

# "true"  → kb-sync reads/writes KB data sources from PostgreSQL
# "false" → kb-sync reads/writes from DynamoDB (default)
USE_PG_KB="false"

# "true"  → discovery worker tracks vector keys in PostgreSQL (InventoryVectorKey)
#            and deletes stale vectors on each scan
# "false" → vectors are upserted but stale cleanup and key tracking are skipped
USE_PG_INVENTORY="false"

# ─── KB Sync — S3 staging bucket ─────────────────────────────────────────────
# S3 bucket where file uploads are staged before chunking/embedding.
KB_STAGING_BUCKET_NAME="your-app-kb-staging-bucket"

# ─── KB Sync — S3 Vectors ─────────────────────────────────────────────────────
# S3 Vectors bucket and index used to store/delete document embeddings.
KB_VECTOR_BUCKET_NAME="nucleus-kb-vectors"
KB_VECTOR_INDEX_NAME="nucleus-kb-index"

# ─── Discovery — S3 Vectors ───────────────────────────────────────────────────
# S3 Vectors bucket and index used to store inventory resource embeddings.
VECTOR_BUCKET_NAME="nucleus-inventory-vectors"
VECTOR_INDEX_NAME="nucleus-inventory-index"

# ─── KB Sync — Bedrock ────────────────────────────────────────────────────────
# Bedrock embedding model ID. Defaults to Titan Embed v2 if not set.
BEDROCK_MODEL_ID="amazon.titan-embed-text-v2:0"

# ─── KB Sync — multi-tenant default ──────────────────────────────────────────
# Tenant ID used for DynamoDB KB vector count updates when USE_PG_KB=false.
DEFAULT_TENANT_ID="org-default"

# ─── Logging ──────────────────────────────────────────────────────────────────
# Log level for worker output. One of: debug, info, warn, error.
# Defaults to "debug" if not set.
LOG_LEVEL="debug"
# Service name prefix printed in every log line for disambiguation in monolithic workers.
# Defaults to "workers" if not set.
SERVICE_NAME="workers"
