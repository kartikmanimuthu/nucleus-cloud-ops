# ============================================================================
# Database
# ============================================================================
# Local dev: docker compose up -d postgres
DATABASE_URL=postgresql://nucleus:nucleus_dev@localhost:5432/nucleus?connection_limit=10

# ============================================================================
# AWS
# ============================================================================
AWS_REGION=ap-south-1
NEXT_PUBLIC_AWS_REGION=ap-south-1
HUB_ACCOUNT_ID=123456789012
NEXT_PUBLIC_HUB_ACCOUNT_ID=123456789012

# ============================================================================
# Authentication — Cognito + NextAuth
# ============================================================================
COGNITO_USER_POOL_ID=ap-south-1_example
COGNITO_APP_CLIENT_ID=example_client_id
COGNITO_APP_CLIENT_SECRET=example_secret
COGNITO_ISSUER=https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_example

NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars

# ============================================================================
# S3 — unified bucket (all features use namespaced prefixes)
# ============================================================================
APP_BUCKET_NAME=nucleus-cloud-ops-123456789012-ap-south-1
# Optional: serve assets via CloudFront instead of direct S3
# ASSETS_CDN_URL=https://your-cloudfront-domain.cloudfront.net

# ============================================================================
# AI / Bedrock
# ============================================================================
BEDROCK_MODEL_ID=amazon.titan-embed-text-v2:0
ASK_AI_GENERATION_MODEL=global.anthropic.claude-sonnet-4-6

# ============================================================================
# Misc
# ============================================================================
DATA_DIR=/tmp
NODE_ENV=development
USE_PG_SCHEDULES=true

# ============================================================================
# Optional integrations
# ============================================================================

# Slack (agent-ops webhook)
# SLACK_SIGNING_SECRET=your-slack-signing-secret

# Jira
# JIRA_WEBHOOK_SECRET=your-jira-webhook-secret
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_USER_EMAIL=bot@your-org.com
# JIRA_API_TOKEN=your-atlassian-api-token

# Tavily (web search tool for AI agent)
# TAVILY_API_KEY=tvly-...

# Langfuse (LLM tracing — set LANGFUSE_ENABLED=true to activate)
# LANGFUSE_ENABLED=true
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# LLM audit logging (logs every Bedrock call — dev only)
# LLM_AUDIT=true

# Skip audit DB writes in local dev
# SKIP_AUDIT_LOGGING=true

# Internal worker→web-ui auth key (must match workers INTERNAL_API_KEY)
# INTERNAL_API_KEY=internal-worker-key

# Deep agent — MongoDB / DocumentDB (only needed if using deep-agent feature)
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB_NAME=nucleus
# DOCDB_ENDPOINT=your-docdb-cluster.cluster-xxx.ap-south-1.docdb.amazonaws.com
# DOCDB_PORT=27017
# DOCDB_USERNAME=nucleus
# DOCDB_PASSWORD=your-password
# DEEP_AGENT_DB_NAME=nucleus
# DEEP_AGENT_LOG_LEVEL=debug

# ---- Right Sizing module (RS-003) ----
# Gates the Right Sizing nav entry, API routes, and worker scheduling.
# RIGHT_SIZING_ENABLED=true
# NEXT_PUBLIC_RIGHT_SIZING_ENABLED=true   # optional: expose flag to client nav
