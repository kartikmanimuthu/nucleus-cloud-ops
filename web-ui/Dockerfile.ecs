# Multi-stage Dockerfile for Next.js Web UI on ECS Fargate
# Optimized for ARM64 (AWS Graviton2) architecture
# Build context: project root (not web-ui/) — required to include prisma/
FROM public.ecr.aws/docker/library/node:20.9.0-slim AS deps
WORKDIR /app

# Copy package files
COPY web-ui/package*.json ./

# Install production dependencies only
RUN npm ci --only=production --omit=dev --legacy-peer-deps && \
    npm cache clean --force

FROM public.ecr.aws/docker/library/node:20.9.0-slim AS builder
WORKDIR /app

# Copy package files
COPY web-ui/package*.json ./

# Install all dependencies for build
RUN npm ci --legacy-peer-deps && \
    npm cache clean --force

# Copy source code and prisma schema
COPY web-ui/ .
COPY prisma/ ./prisma/

# Set Next.js environment for standalone build
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_SHARP_PATH=/tmp/node_modules/sharp

# Set build-time environment variables
ENV NEXT_PUBLIC_AWS_REGION=ap-south-1
ENV NEXT_PUBLIC_APP_TABLE_NAME=NucleusAppTable
ENV NEXT_PUBLIC_AUDIT_TABLE_NAME=NucleusAuditTable
ENV NEXT_PUBLIC_AWS_USE_STS=true

# Generate Prisma client before building (required for @prisma/client to initialize)
# In this Docker context, web-ui/ contents are copied directly into /app/ (not /app/web-ui/),
# so patch the schema output path from ../web-ui/node_modules to ../node_modules before generating.
RUN sed -i 's|"../web-ui/node_modules/.prisma/client"|"../node_modules/.prisma/client"|' ./prisma/schema.prisma && \
    npx prisma@5 generate --schema=./prisma/schema.prisma

# Build the application
RUN npm run build

FROM public.ecr.aws/docker/library/node:20.9.0-slim AS runner
WORKDIR /app

# Install system dependencies, AWS CLI, Python3 (for uvx/MCP servers), and tools
RUN apt-get update && \
    apt-get install -y \
    curl \
    unzip \
    git \
    jq \
    less \
    groff \
    grep \
    openssl \
    python3 \
    python3-venv && \
    curl "https://awscli.amazonaws.com/awscli-exe-linux-aarch64.zip" -o "awscliv2.zip" && \
    unzip awscliv2.zip && \
    ./aws/install && \
    rm -rf aws awscliv2.zip && \
    rm -rf /var/lib/apt/lists/*

# Install uv (Python package manager) for uvx MCP server support
# Install as root first, then make available to all users
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    cp /root/.local/bin/uv /usr/local/bin/uv && \
    cp /root/.local/bin/uvx /usr/local/bin/uvx && \
    chmod +x /usr/local/bin/uv /usr/local/bin/uvx

# Set environment variables
ENV PORT=3000 \
    HOSTNAME="0.0.0.0" \
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    NEXTAUTH_SECRET='iojifjifjfijffjijiehyudfytwfdtrdreswrsrxedctfvygbuhnjmk' \
    NEXT_PUBLIC_AWS_REGION=ap-south-1 \
    NEXT_PUBLIC_APP_TABLE_NAME=NucleusAppTable \
    NEXT_PUBLIC_AUDIT_TABLE_NAME=NucleusAuditTable \
    NEXT_PUBLIC_AWS_USE_STS=true \
    NEXT_PUBLIC_TESTING1='testing1'

# Download Amazon DocumentDB / RDS CA bundle for TLS connections
RUN curl -sSL https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem \
    -o /etc/ssl/certs/rds-combined-ca-bundle.pem

# Create necessary directories
RUN mkdir -p /tmp/cache && \
    mkdir -p .next/cache

# Copy built application assets
COPY --from=builder /app/public ./public
# Copy package.json for potential usage or metadata
COPY --from=builder /app/package.json ./package.json

# Copy standalone build output
# This places server.js and necessary node_modules in /app
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

# Copy generated Prisma client (not included in standalone output)
# prisma generate outputs to /app/node_modules/.prisma/client (after sed patch above)
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma/client ./node_modules/@prisma/client


# Create symbolic link for cache
RUN ln -sf /tmp/cache ./.next/cache

# Set proper permissions
RUN chown -R node:node /app /tmp/cache

# Switch to non-root user
USER node

# Expose port
EXPOSE 3000

# Copy Prisma schema for migrate deploy at startup
COPY --from=builder /app/prisma ./prisma

# Start: run migrations then start the app
CMD ["sh", "-c", "npx prisma@5 migrate deploy --schema=./prisma/schema.prisma && node server.js"]
