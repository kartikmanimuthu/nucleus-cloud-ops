{
  "name": "networking",
  "projectType": "application",
  "targets": {
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pulumi preview --stack prod",
        "cwd": "infra/networking"
      }
    },
    "up": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pulumi up --stack prod --yes",
        "cwd": "infra/networking"
      }
    },
    "destroy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pulumi destroy --stack prod",
        "cwd": "infra/networking"
      }
    }
  }
}